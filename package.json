{
  "name": "aws-warehouse-intake",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Warehouse console with password login, barcode receiving, operator audit and DynamoDB/SQS containers without Lambda",
  "repository": "https://github.com/helberjf/aws-warehouse-intake",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "npm run typecheck && npm run format:check && npm test && npm run schema:check",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema:write": "node scripts/export-schema.ts --write",
    "schema:check": "node scripts/export-schema.ts",
    "capacity": "node scripts/capacity.ts",
    "start": "node src/main.ts",
    "local:setup": "node scripts/local-setup.ts",
    "local:token": "node --env-file=.env scripts/local-token.ts",
    "test:integration": "node --test --test-concurrency=1 integration/*.test.ts",
    "test:load": "node --env-file=.env scripts/load-test.ts",
    "reconcile": "node --env-file=.env scripts/reconcile.ts",
    "local:configure": "node scripts/local-configure.ts",
    "user:create": "node --env-file=.env scripts/create-user.ts",
    "test:e2e": "node --env-file=.env node_modules/@playwright/test/cli.js test",
    "migrate:indexes": "node --env-file=.env scripts/backfill-indexes.ts",
    "demo:seed": "node --env-file=.env scripts/demo-seed.ts",
    "costs": "node scripts/estimate-cost.ts",
    "test:load:warehouses": "node --env-file=.env scripts/warehouse-load.ts",
    "test:load:monitor": "node --env-file=.env scripts/load-monitor.ts",
    "test:load:audit": "node --env-file=.env scripts/audit-load.ts",
    "build:frontend": "node scripts/build-frontend.ts",
    "prepreview:frontend": "npm run build:frontend",
    "preview:frontend": "node scripts/preview-frontend.ts",
    "test:frontend": "playwright test --config playwright.frontend.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1162.0",
    "@aws-sdk/client-sqs": "^3.1162.0",
    "@aws-sdk/lib-dynamodb": "^3.1162.0",
    "@zxing/browser": "^0.2.1",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
