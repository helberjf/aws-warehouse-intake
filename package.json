{
  "name": "aws-warehouse-intake",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-warehouse receiving API and container workers with DynamoDB and SQS, without Lambda",
  "repository": "https://github.com/helberjf/aws-warehouse-intake",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "npm run typecheck && npm run format:check && npm test && npm run schema:check",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema:write": "node scripts/export-schema.ts --write",
    "schema:check": "node scripts/export-schema.ts",
    "capacity": "node scripts/capacity.ts",
    "start": "node src/main.ts",
    "local:setup": "node scripts/local-setup.ts",
    "local:token": "node --env-file=.env scripts/local-token.ts",
    "test:integration": "node --test --test-concurrency=1 integration/*.test.ts",
    "test:load": "node --env-file=.env scripts/load-test.ts",
    "reconcile": "node --env-file=.env scripts/reconcile.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1162.0",
    "@aws-sdk/client-sqs": "^3.1162.0",
    "@aws-sdk/lib-dynamodb": "^3.1162.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
