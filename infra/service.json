{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Warehouse intake on ECS Fargate, DynamoDB and SQS. Uses existing VPC, TLS certificate and immutable ECR image.",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "VpcCidr": {
      "Type": "String",
      "AllowedPattern": "[0-9.]+/[0-9]+",
      "Description": "CIDR of existing VPC for ALB-to-task egress"
    },
    "PublicSubnetIds": {
      "Type": "List<AWS::EC2::Subnet::Id>",
      "Description": "At least two public subnets in different Availability Zones"
    },
    "PrivateSubnetIds": {
      "Type": "List<AWS::EC2::Subnet::Id>",
      "Description": "Private subnets in at least two AZs with outbound HTTPS connectivity"
    },
    "CertificateArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws[a-z-]*:acm:[a-z0-9-]+:[0-9]{12}:certificate/.+"
    },
    "ImageUri": {
      "Type": "String",
      "AllowedPattern": "[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com(\\.cn)?/.+@sha256:[a-f0-9]{64}",
      "Description": "Private ECR image pinned to digest, built for linux/amd64"
    },
    "RepositoryArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws[a-z-]*:ecr:[a-z0-9-]+:[0-9]{12}:repository/.+"
    },
    "JwtIssuer": {
      "Type": "String",
      "AllowedPattern": "https://.+"
    },
    "JwtAudience": {
      "Type": "String",
      "MinLength": 1
    },
    "JwtJwksUrl": {
      "Type": "String",
      "AllowedPattern": "https://.+"
    },
    "ApiMinTasks": {
      "Type": "Number",
      "Default": 2,
      "MinValue": 2,
      "MaxValue": 20
    },
    "ApiMaxTasks": {
      "Type": "Number",
      "Default": 10,
      "MinValue": 2,
      "MaxValue": 100
    },
    "WorkerMinTasks": {
      "Type": "Number",
      "Default": 2,
      "MinValue": 2,
      "MaxValue": 20
    },
    "WorkerMaxTasks": {
      "Type": "Number",
      "Default": 20,
      "MinValue": 2,
      "MaxValue": 100
    },
    "BacklogPerWorker": {
      "Type": "Number",
      "Default": 100,
      "MinValue": 1,
      "Description": "Tune from measured processing time and acceptable queue delay"
    },
    "AlarmTopicArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "(^$|arn:aws[a-z-]*:sns:[a-z0-9-]+:[0-9]{12}:.+)",
      "Description": "Optional existing SNS topic for alarm notifications; alarm state still recorded if empty"
    }
  },
  "Conditions": {
    "HasAlarmTopic": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "AlarmTopicArn"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "Table": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "sk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "duePK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "dueSK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "historyPK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "historySK",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "sk",
            "KeyType": "RANGE"
          }
        ],
        "GlobalSecondaryIndexes": [
          {
            "IndexName": "due-index",
            "KeySchema": [
              {
                "AttributeName": "duePK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "dueSK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          },
          {
            "IndexName": "history-index",
            "KeySchema": [
              {
                "AttributeName": "historyPK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "historySK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          }
        ],
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "SSESpecification": {
          "SSEEnabled": true
        },
        "TimeToLiveSpecification": {
          "AttributeName": "expiresAt",
          "Enabled": true
        },
        "DeletionProtectionEnabled": true
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "DeadLetterQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "SqsManagedSseEnabled": true,
        "MessageRetentionPeriod": 1209600,
        "RedriveAllowPolicy": {
          "redrivePermission": "byQueue",
          "sourceQueueArns": [
            {
              "Fn::Sub": "arn:${AWS::Partition}:sqs:${AWS::Region}:${AWS::AccountId}:${AWS::StackName}-intake"
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "Queue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": {
          "Fn::Sub": "${AWS::StackName}-intake"
        },
        "SqsManagedSseEnabled": true,
        "MessageRetentionPeriod": 345600,
        "VisibilityTimeout": 60,
        "ReceiveMessageWaitTimeSeconds": 20,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": ["DeadLetterQueue", "Arn"]
          },
          "maxReceiveCount": 5
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "QueuePolicy": {
      "Type": "AWS::SQS::QueuePolicy",
      "Properties": {
        "Queues": [
          {
            "Ref": "Queue"
          },
          {
            "Ref": "DeadLetterQueue"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "RequireTLS",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "sqs:*",
              "Resource": [
                {
                  "Fn::GetAtt": ["Queue", "Arn"]
                },
                {
                  "Fn::GetAtt": ["DeadLetterQueue", "Arn"]
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": false
                }
              }
            }
          ]
        }
      }
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterSettings": [
          {
            "Name": "containerInsights",
            "Value": "enabled"
          }
        ]
      }
    },
    "LoadBalancerSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Public HTTPS entry; HTTP redirects to HTTPS",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 3000,
            "ToPort": 3000,
            "CidrIp": {
              "Ref": "VpcCidr"
            }
          }
        ]
      }
    },
    "ApiSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "API accepts only ALB traffic",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 3000,
            "ToPort": 3000,
            "SourceSecurityGroupId": {
              "Ref": "LoadBalancerSecurityGroup"
            }
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "BackgroundSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Background services have no inbound access",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "LoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Scheme": "internet-facing",
        "Type": "application",
        "SecurityGroups": [
          {
            "Ref": "LoadBalancerSecurityGroup"
          }
        ],
        "Subnets": {
          "Ref": "PublicSubnetIds"
        },
        "LoadBalancerAttributes": [
          {
            "Key": "routing.http.drop_invalid_header_fields.enabled",
            "Value": "true"
          },
          {
            "Key": "routing.http.desync_mitigation_mode",
            "Value": "strictest"
          },
          {
            "Key": "deletion_protection.enabled",
            "Value": "true"
          }
        ]
      }
    },
    "TargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Port": 3000,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "VpcId": {
          "Ref": "VpcId"
        },
        "HealthCheckPath": "/ready",
        "HealthCheckIntervalSeconds": 15,
        "HealthCheckTimeoutSeconds": 5,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 3,
        "Matcher": {
          "HttpCode": "200"
        },
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ]
      }
    },
    "HttpsListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "LoadBalancer"
        },
        "Port": 443,
        "Protocol": "HTTPS",
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "Certificates": [
          {
            "CertificateArn": {
              "Ref": "CertificateArn"
            }
          }
        ],
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            }
          }
        ]
      }
    },
    "HttpListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "LoadBalancer"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "redirect",
            "RedirectConfig": {
              "Protocol": "HTTPS",
              "Port": "443",
              "StatusCode": "HTTP_301"
            }
          }
        ]
      }
    },
    "ApiLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 30
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ApiExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": ["ecs-tasks.amazonaws.com"]
              },
              "Action": ["sts:AssumeRole"]
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ContainerBootstrap",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": ["ecr:GetAuthorizationToken"],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": {
                    "Ref": "RepositoryArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
                  "Resource": {
                    "Fn::GetAtt": ["ApiLogs", "Arn"]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ApiTaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": ["ecs-tasks.amazonaws.com"]
              },
              "Action": ["sts:AssumeRole"]
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ApplicationAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:DescribeTable",
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:Query",
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": ["Table", "Arn"]
                    },
                    {
                      "Fn::Sub": "${Table.Arn}/index/*"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "ApiTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Cpu": "512",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": ["FARGATE"],
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": ["ApiExecutionRole", "Arn"]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": ["ApiTaskRole", "Arn"]
        },
        "ContainerDefinitions": [
          {
            "Name": "api",
            "Image": {
              "Ref": "ImageUri"
            },
            "Essential": true,
            "User": "1000:1000",
            "ReadonlyRootFilesystem": true,
            "StopTimeout": 120,
            "Environment": [
              {
                "Name": "ENVIRONMENT",
                "Value": "production"
              },
              {
                "Name": "SERVICE_ROLE",
                "Value": "api"
              },
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "TABLE_NAME",
                "Value": {
                  "Ref": "Table"
                }
              },
              {
                "Name": "QUEUE_URL",
                "Value": {
                  "Ref": "Queue"
                }
              },
              {
                "Name": "HOST",
                "Value": "0.0.0.0"
              },
              {
                "Name": "PORT",
                "Value": "3000"
              },
              {
                "Name": "JWT_ISSUER",
                "Value": {
                  "Ref": "JwtIssuer"
                }
              },
              {
                "Name": "JWT_AUDIENCE",
                "Value": {
                  "Ref": "JwtAudience"
                }
              },
              {
                "Name": "JWT_JWKS_URL",
                "Value": {
                  "Ref": "JwtJwksUrl"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "ApiLogs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "api"
              }
            },
            "PortMappings": [
              {
                "ContainerPort": 3000,
                "Protocol": "tcp"
              }
            ],
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "node -e \"fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""
              ],
              "Interval": 30,
              "Timeout": 5,
              "Retries": 3,
              "StartPeriod": 30
            },
            "LinuxParameters": {
              "Capabilities": {
                "Drop": ["ALL"]
              },
              "InitProcessEnabled": true
            }
          }
        ]
      }
    },
    "ApiService": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "TaskDefinition": {
          "Ref": "ApiTask"
        },
        "LaunchType": "FARGATE",
        "PlatformVersion": "LATEST",
        "DesiredCount": {
          "Ref": "ApiMinTasks"
        },
        "EnableECSManagedTags": true,
        "PropagateTags": "SERVICE",
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          },
          "MinimumHealthyPercent": 100,
          "MaximumPercent": 200
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "Subnets": {
              "Ref": "PrivateSubnetIds"
            },
            "SecurityGroups": [
              {
                "Ref": "ApiSecurityGroup"
              }
            ]
          }
        },
        "LoadBalancers": [
          {
            "ContainerName": "api",
            "ContainerPort": 3000,
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            }
          }
        ],
        "HealthCheckGracePeriodSeconds": 60
      },
      "DependsOn": ["HttpsListener"]
    },
    "ApiScalingTarget": {
      "Type": "AWS::ApplicationAutoScaling::ScalableTarget",
      "Properties": {
        "MinCapacity": {
          "Ref": "ApiMinTasks"
        },
        "MaxCapacity": {
          "Ref": "ApiMaxTasks"
        },
        "ResourceId": {
          "Fn::Sub": "service/${Cluster}/${ApiService.Name}"
        },
        "ScalableDimension": "ecs:service:DesiredCount",
        "ServiceNamespace": "ecs"
      }
    },
    "ApiCpuScaling": {
      "Type": "AWS::ApplicationAutoScaling::ScalingPolicy",
      "Properties": {
        "PolicyName": {
          "Fn::Sub": "${AWS::StackName}-api-cpu"
        },
        "PolicyType": "TargetTrackingScaling",
        "ScalingTargetId": {
          "Ref": "ApiScalingTarget"
        },
        "TargetTrackingScalingPolicyConfiguration": {
          "TargetValue": 60,
          "ScaleInCooldown": 300,
          "ScaleOutCooldown": 60,
          "PredefinedMetricSpecification": {
            "PredefinedMetricType": "ECSServiceAverageCPUUtilization"
          }
        }
      }
    },
    "PublisherLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 30
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "PublisherExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": ["ecs-tasks.amazonaws.com"]
              },
              "Action": ["sts:AssumeRole"]
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ContainerBootstrap",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": ["ecr:GetAuthorizationToken"],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": {
                    "Ref": "RepositoryArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
                  "Resource": {
                    "Fn::GetAtt": ["PublisherLogs", "Arn"]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "PublisherTaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": ["ecs-tasks.amazonaws.com"]
              },
              "Action": ["sts:AssumeRole"]
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ApplicationAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": ["dynamodb:GetItem", "dynamodb:Query", "dynamodb:UpdateItem"],
                  "Resource": [
                    {
                      "Fn::GetAtt": ["Table", "Arn"]
                    },
                    {
                      "Fn::Sub": "${Table.Arn}/index/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": ["sqs:SendMessage"],
                  "Resource": {
                    "Fn::GetAtt": ["Queue", "Arn"]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "PublisherTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Cpu": "256",
        "Memory": "512",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": ["FARGATE"],
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": ["PublisherExecutionRole", "Arn"]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": ["PublisherTaskRole", "Arn"]
        },
        "ContainerDefinitions": [
          {
            "Name": "publisher",
            "Image": {
              "Ref": "ImageUri"
            },
            "Essential": true,
            "User": "1000:1000",
            "ReadonlyRootFilesystem": true,
            "StopTimeout": 120,
            "Environment": [
              {
                "Name": "ENVIRONMENT",
                "Value": "production"
              },
              {
                "Name": "SERVICE_ROLE",
                "Value": "publisher"
              },
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "TABLE_NAME",
                "Value": {
                  "Ref": "Table"
                }
              },
              {
                "Name": "QUEUE_URL",
                "Value": {
                  "Ref": "Queue"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "PublisherLogs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "publisher"
              }
            },
            "LinuxParameters": {
              "Capabilities": {
                "Drop": ["ALL"]
              },
              "InitProcessEnabled": true
            }
          }
        ]
      }
    },
    "PublisherService": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "TaskDefinition": {
          "Ref": "PublisherTask"
        },
        "LaunchType": "FARGATE",
        "PlatformVersion": "LATEST",
        "DesiredCount": 1,
        "EnableECSManagedTags": true,
        "PropagateTags": "SERVICE",
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          },
          "MinimumHealthyPercent": 100,
          "MaximumPercent": 200
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "Subnets": {
              "Ref": "PrivateSubnetIds"
            },
            "SecurityGroups": [
              {
                "Ref": "BackgroundSecurityGroup"
              }
            ]
          }
        }
      }
    },
    "WorkerLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 30
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "WorkerExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": ["ecs-tasks.amazonaws.com"]
              },
              "Action": ["sts:AssumeRole"]
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ContainerBootstrap",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": ["ecr:GetAuthorizationToken"],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": {
                    "Ref": "RepositoryArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
                  "Resource": {
                    "Fn::GetAtt": ["WorkerLogs", "Arn"]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "WorkerTaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": ["ecs-tasks.amazonaws.com"]
              },
              "Action": ["sts:AssumeRole"]
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ApplicationAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:Query",
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": ["Table", "Arn"]
                    },
                    {
                      "Fn::Sub": "${Table.Arn}/index/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:ChangeMessageVisibility",
                    "sqs:GetQueueAttributes"
                  ],
                  "Resource": {
                    "Fn::GetAtt": ["Queue", "Arn"]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "WorkerTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Cpu": "512",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": ["FARGATE"],
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": ["WorkerExecutionRole", "Arn"]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": ["WorkerTaskRole", "Arn"]
        },
        "ContainerDefinitions": [
          {
            "Name": "worker",
            "Image": {
              "Ref": "ImageUri"
            },
            "Essential": true,
            "User": "1000:1000",
            "ReadonlyRootFilesystem": true,
            "StopTimeout": 120,
            "Environment": [
              {
                "Name": "ENVIRONMENT",
                "Value": "production"
              },
              {
                "Name": "SERVICE_ROLE",
                "Value": "worker"
              },
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "TABLE_NAME",
                "Value": {
                  "Ref": "Table"
                }
              },
              {
                "Name": "QUEUE_URL",
                "Value": {
                  "Ref": "Queue"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "WorkerLogs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "worker"
              }
            },
            "LinuxParameters": {
              "Capabilities": {
                "Drop": ["ALL"]
              },
              "InitProcessEnabled": true
            }
          }
        ]
      }
    },
    "WorkerService": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "TaskDefinition": {
          "Ref": "WorkerTask"
        },
        "LaunchType": "FARGATE",
        "PlatformVersion": "LATEST",
        "DesiredCount": {
          "Ref": "WorkerMinTasks"
        },
        "EnableECSManagedTags": true,
        "PropagateTags": "SERVICE",
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          },
          "MinimumHealthyPercent": 100,
          "MaximumPercent": 200
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "Subnets": {
              "Ref": "PrivateSubnetIds"
            },
            "SecurityGroups": [
              {
                "Ref": "BackgroundSecurityGroup"
              }
            ]
          }
        }
      }
    },
    "WorkerScalingTarget": {
      "Type": "AWS::ApplicationAutoScaling::ScalableTarget",
      "Properties": {
        "MinCapacity": {
          "Ref": "WorkerMinTasks"
        },
        "MaxCapacity": {
          "Ref": "WorkerMaxTasks"
        },
        "ResourceId": {
          "Fn::Sub": "service/${Cluster}/${WorkerService.Name}"
        },
        "ScalableDimension": "ecs:service:DesiredCount",
        "ServiceNamespace": "ecs"
      }
    },
    "WorkerCpuScaling": {
      "Type": "AWS::ApplicationAutoScaling::ScalingPolicy",
      "Properties": {
        "PolicyName": {
          "Fn::Sub": "${AWS::StackName}-worker-cpu"
        },
        "PolicyType": "TargetTrackingScaling",
        "ScalingTargetId": {
          "Ref": "WorkerScalingTarget"
        },
        "TargetTrackingScalingPolicyConfiguration": {
          "TargetValue": 60,
          "ScaleInCooldown": 300,
          "ScaleOutCooldown": 60,
          "PredefinedMetricSpecification": {
            "PredefinedMetricType": "ECSServiceAverageCPUUtilization"
          }
        }
      }
    },
    "WorkerBacklogScaling": {
      "Type": "AWS::ApplicationAutoScaling::ScalingPolicy",
      "Properties": {
        "PolicyName": {
          "Fn::Sub": "${AWS::StackName}-worker-backlog"
        },
        "PolicyType": "TargetTrackingScaling",
        "ScalingTargetId": {
          "Ref": "WorkerScalingTarget"
        },
        "TargetTrackingScalingPolicyConfiguration": {
          "TargetValue": {
            "Ref": "BacklogPerWorker"
          },
          "ScaleInCooldown": 300,
          "ScaleOutCooldown": 60,
          "CustomizedMetricSpecification": {
            "Metrics": [
              {
                "Id": "queued",
                "MetricStat": {
                  "Metric": {
                    "Namespace": "AWS/SQS",
                    "MetricName": "ApproximateNumberOfMessagesVisible",
                    "Dimensions": [
                      {
                        "Name": "QueueName",
                        "Value": {
                          "Fn::GetAtt": ["Queue", "QueueName"]
                        }
                      }
                    ]
                  },
                  "Stat": "Sum"
                },
                "ReturnData": false
              },
              {
                "Id": "running",
                "MetricStat": {
                  "Metric": {
                    "Namespace": "ECS/ContainerInsights",
                    "MetricName": "RunningTaskCount",
                    "Dimensions": [
                      {
                        "Name": "ClusterName",
                        "Value": {
                          "Ref": "Cluster"
                        }
                      },
                      {
                        "Name": "ServiceName",
                        "Value": {
                          "Fn::GetAtt": ["WorkerService", "Name"]
                        }
                      }
                    ]
                  },
                  "Stat": "Average"
                },
                "ReturnData": false
              },
              {
                "Id": "backlog",
                "Expression": "IF(running>0,queued/running,queued)",
                "Label": "Messages per running worker",
                "ReturnData": true
              }
            ]
          }
        }
      }
    },
    "QueueAgeAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Receiving backlog older than five minutes",
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateAgeOfOldestMessage",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Fn::GetAtt": ["Queue", "QueueName"]
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 2,
        "Threshold": 300,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": {
          "Fn::If": [
            "HasAlarmTopic",
            [
              {
                "Ref": "AlarmTopicArn"
              }
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    },
    "DeadLetterAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Messages need investigation before controlled redrive",
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Fn::GetAtt": ["DeadLetterQueue", "QueueName"]
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 2,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": {
          "Fn::If": [
            "HasAlarmTopic",
            [
              {
                "Ref": "AlarmTopicArn"
              }
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    },
    "ApiErrorsAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Repeated API server failures",
        "Namespace": "AWS/ApplicationELB",
        "MetricName": "HTTPCode_Target_5XX_Count",
        "Dimensions": [
          {
            "Name": "LoadBalancer",
            "Value": {
              "Fn::GetAtt": ["LoadBalancer", "LoadBalancerFullName"]
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 60,
        "EvaluationPeriods": 2,
        "Threshold": 5,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": {
          "Fn::If": [
            "HasAlarmTopic",
            [
              {
                "Ref": "AlarmTopicArn"
              }
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    },
    "PublisherFailureMetric": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "PublisherLogs"
        },
        "FilterPattern": "{ ($.event = \"outbox_publish_failed\") || ($.event = \"outbox_release_failed\") || ($.event = \"publisher_poll_failed\") || ($.event = \"service_failed\") }",
        "MetricTransformations": [
          {
            "MetricNamespace": "WarehouseIntake",
            "MetricName": {
              "Fn::Sub": "${AWS::StackName}-PublisherFailures"
            },
            "MetricValue": "1",
            "DefaultValue": 0
          }
        ]
      }
    },
    "PublisherFailureAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Repeated publisher errors; investigate structured logs and affected ledger entries",
        "Namespace": "WarehouseIntake",
        "MetricName": {
          "Fn::Sub": "${AWS::StackName}-PublisherFailures"
        },
        "Statistic": "Sum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "Threshold": 3,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": {
          "Fn::If": [
            "HasAlarmTopic",
            [
              {
                "Ref": "AlarmTopicArn"
              }
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    },
    "WorkerFailureMetric": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "WorkerLogs"
        },
        "FilterPattern": "{ ($.event = \"queue_message_failed\") || ($.event = \"worker_poll_failed\") || ($.event = \"service_failed\") }",
        "MetricTransformations": [
          {
            "MetricNamespace": "WarehouseIntake",
            "MetricName": {
              "Fn::Sub": "${AWS::StackName}-WorkerFailures"
            },
            "MetricValue": "1",
            "DefaultValue": 0
          }
        ]
      }
    },
    "WorkerFailureAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Repeated worker errors; investigate structured logs and affected ledger entries",
        "Namespace": "WarehouseIntake",
        "MetricName": {
          "Fn::Sub": "${AWS::StackName}-WorkerFailures"
        },
        "Statistic": "Sum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "Threshold": 3,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": {
          "Fn::If": [
            "HasAlarmTopic",
            [
              {
                "Ref": "AlarmTopicArn"
              }
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "LoadBalancerDns": {
      "Value": {
        "Fn::GetAtt": ["LoadBalancer", "DNSName"]
      }
    },
    "TableName": {
      "Value": {
        "Ref": "Table"
      }
    },
    "QueueUrl": {
      "Value": {
        "Ref": "Queue"
      }
    },
    "DeadLetterQueueUrl": {
      "Value": {
        "Ref": "DeadLetterQueue"
      }
    },
    "ClusterName": {
      "Value": {
        "Ref": "Cluster"
      }
    },
    "ApiService": {
      "Value": {
        "Fn::GetAtt": ["ApiService", "Name"]
      }
    },
    "PublisherService": {
      "Value": {
        "Fn::GetAtt": ["PublisherService", "Name"]
      }
    },
    "WorkerService": {
      "Value": {
        "Fn::GetAtt": ["WorkerService", "Name"]
      }
    }
  }
}
