{
  "openapi": "3.1.0",
  "info": {
    "title": "AWS Warehouse Intake API",
    "version": "1.0.0",
    "description": "Multi-warehouse receiving with individually serialized units and bulk quantities. JWT claims: sub, iat, exp, organizationId, producerId, warehouseIds and roles (receiving/admin). Warehouse access is explicit, including for administrators. A 202 response confirms durable acceptance; poll status until APPLIED or REJECTED. List results use an eventually consistent index. Idempotency-Key and externalReference must stay stable across retries."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
