  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ReceivingEntry": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "skuId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "externalReference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "occurredAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "mode": {
                "type": "string",
                "const": "SERIALIZED"
              },
              "serialNumber": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": ["skuId", "externalReference", "occurredAt", "mode", "serialNumber"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "skuId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "externalReference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "occurredAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "mode": {
                "type": "string",
                "const": "BULK"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "lotCode": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": ["skuId", "externalReference", "occurredAt", "mode", "quantity"],
            "additionalProperties": false
          }
        ]
      },
      "LedgerEntry": {
        "type": "object",
        "required": ["entryId", "warehouseId", "producerId", "entry", "quantity", "status", "acceptedAt"],
        "properties": {
          "entryId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "warehouseId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "producerId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "entry": {
            "$ref": "#/components/schemas/ReceivingEntry"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": ["ACCEPTED", "APPLIED", "REJECTED"]
          },
          "acceptedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "rejectionReason": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error", "requestId"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "requestId": {
            "type": "string"
          }
        }
      }
    }
  }
}
